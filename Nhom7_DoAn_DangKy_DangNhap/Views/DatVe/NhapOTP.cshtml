@{
    ViewBag.Title = "Xác nhận mã OTP";
    var suat = ViewBag.Suat as Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu;
    var chiTietGhe = ViewBag.ChiTietGhe as List<(string TenGhe, string LoaiGhe, decimal Gia)>;
    var tongTien = ViewBag.TongTien as decimal? ?? 0;
}

<h2 class="text-center text-primary mb-3">🔐 Xác nhận mã OTP</h2>

<div class="card p-4 shadow-lg">

    <p><strong>🎬 Phim:</strong> @suat?.Phim?.TenPhim</p>
    <p><strong>📅 Ngày chiếu:</strong> @suat?.NgayChieu.ToString("dd/MM/yyyy")</p>
    <p><strong>🕒 Giờ chiếu:</strong> @suat?.ThoiGianChieu.ToString(@"hh\:mm")</p>
    <p><strong>💺 Ghế:</strong> @(chiTietGhe?.Any() == true ? string.Join(", ", chiTietGhe.Select(g => g.TenGhe)) : "Không có")</p>
    <p><strong>💰 Tổng tiền:</strong> <span class="text-danger fw-bold">@tongTien.ToString("N0") VNĐ</span></p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Message"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }

    <form asp-action="XacNhanOTP" method="post" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Nhập mã OTP:</label>
            <input type="number" name="otp" class="form-control" maxlength="6" placeholder="Nhập 6 số OTP..." required />
        </div>

        <button type="submit" class="btn btn-primary w-100">✅ Xác nhận</button>
        <a asp-action="ThanhToanForm" asp-route-maSuatChieu="@suat?.MaSuatChieu" class="btn btn-secondary w-100 mt-2">⬅ Quay lại</a>
    </form>
</div>
