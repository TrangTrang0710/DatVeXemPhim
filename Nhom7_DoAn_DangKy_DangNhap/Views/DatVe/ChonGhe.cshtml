@{
    var suat = ViewBag.SuatChieu;
    var gheTheoHang = ViewBag.GheTheoHang as Dictionary<string, List<Nhom7_DoAn_DangKy_DangNhap.Models.Ghe>>;
    var gheDaDat = ViewBag.GheDaDat as List<string>;
}

<h2 class="text-center">Chọn ghế - Phim: @suat?.Phim?.TenPhim</h2>

<form method="post" asp-action="ThanhToanForm" asp-controller="DatVe">
    <input type="hidden" name="maSuatChieu" value="@suat?.MaSuatChieu" />

    <div class="text-center my-4">
        <strong class="screen">--- MÀN HÌNH ---</strong>
    </div>

    <div class="container d-flex flex-column align-items-center">
        @if (gheTheoHang != null && gheTheoHang.Any())
        {
            foreach (var hang in gheTheoHang.OrderBy(h => h.Key))
            {
                <div class="d-flex align-items-center justify-content-center mb-2">
                    <span class="me-2" style="width: 40px;"><strong>@hang.Key</strong></span>
                    @foreach (var ghe in hang.Value.OrderBy(g => int.Parse(g.TenGhe.Substring(1))))
                    {
                        bool isDisabled = gheDaDat != null && gheDaDat.Contains(ghe.TenGhe);
                        string baseClass = ghe.MaLoaiGhe switch
                        {
                            "LG02" => "btn-danger",  // VIP
                            "LG03" => "btn-warning", // Couple
                            _ => "btn-primary"       // Thường
                        };
                        string cssClass = isDisabled ? "btn btn-secondary" : $"btn {baseClass} selectable";

                        <label class="@cssClass m-1 seat-label text-center" style="width: 60px; cursor: pointer;">
                            <input type="checkbox" name="gheDaChon" value="@ghe.TenGhe" @(isDisabled ? "disabled" : "") hidden />
                            @ghe.TenGhe
                        </label>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-danger">Không có dữ liệu ghế để hiển thị!</p>
        }
    </div>

    <div class="mt-4 text-center">
        <span class="btn btn-primary">Ghế thường</span>
        <span class="btn btn-danger">Ghế VIP</span>
        <span class="btn btn-warning">Ghế Couple</span>
        <span class="btn btn-secondary">Đã đặt</span>
    </div>

    <div class="text-center mt-4">
        <button type="submit" class="btn btn-success">Tiếp tục thanh toán</button>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.selectable').forEach(function (label) {
            const checkbox = label.querySelector('input[type="checkbox"]');

            label.addEventListener('click', function (e) {
                e.preventDefault();

                checkbox.checked = !checkbox.checked;

                if (checkbox.checked) {
                    label.classList.add('bg-light', 'text-dark', 'border', 'border-light', 'opacity-75');
                } else {
                    label.classList.remove('bg-light', 'text-dark', 'border', 'border-light', 'opacity-75');
                }
            });
        });
    </script>
}
