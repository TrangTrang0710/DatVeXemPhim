@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.Ghe>
@{
    var suat = ViewBag.SuatChieu;
}
<h2>Chọn ghế cho phim: @suat.Phim.TenPhim</h2>
<p>Ngày: @suat.NgayChieu.ToString("dd/MM/yyyy") - Giờ: @suat.ThoiGianChieu</p>

<form method="post" action="/DatVe/ThanhToan">
    <input type="hidden" name="maSuatChieu" value="@suat.MaSuatChieu" />
    <div style="display:flex;flex-wrap:wrap;gap:10px;">
        @foreach (var ghe in Model)
        {
            string cssClass = ghe.MaLoaiGhe switch
            {
                "VIP" => "btn btn-danger", // VIP màu đỏ
                "COUPLE" => "btn btn-warning", // Ghế đôi màu vàng
                _ => "btn btn-primary" // Thường màu xanh
            };
            <label style="width:60px;text-align:center;">
                <input type="checkbox" name="gheDaChon[]" value="@ghe.TenGhe" /> @ghe.TenGhe
            </label>
        }
    </div>
    <div class="mt-3">
        <label>Chọn phương thức thanh toán:</label>
        <select name="phuongThuc" class="form-control" required>
            <option value="">-- Chọn --</option>
            <option value="MoMo">Thanh toán qua MoMo</option>
            <option value="VNPay">Thanh toán qua VNPay</option>
            <option value="TienMat">Thanh toán tiền mặt</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success mt-3">Thanh toán</button>
</form>
