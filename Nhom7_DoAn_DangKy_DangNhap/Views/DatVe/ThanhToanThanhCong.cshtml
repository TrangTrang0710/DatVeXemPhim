@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "~/Views/Shared/Layout.cshtml";
    var veList = ViewBag.DanhSachVe as List<Nhom7_DoAn_DangKy_DangNhap.Models.Ve>;
    var ngayDat = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
}

<div class="container mt-5">
    <div class="text-center">
        <div class="alert alert-success shadow p-4 rounded">
            <h2 class="fw-bold text-success">🎉 Đặt vé thành công!</h2>
            <p class="fs-5 text-muted">Cảm ơn bạn đã đặt vé tại <strong>Rạp Phim TX3</strong></p>
        </div>
    </div>

    @if (veList != null && veList.Count > 0)
    {
        var veDaiDien = veList.First();
        var gioChieu = veDaiDien.SuatChieu!.NgayChieu.Add(veDaiDien.SuatChieu.ThoiGianChieu);

        <div class="card shadow-sm border-0 mx-auto mt-4" style="max-width: 600px;">
            <div class="card-body">
                <h4 class="mb-3 text-primary">🎫 Thông Tin Vé</h4>

                <div class="mb-2"><strong>🎬 Phim:</strong> @veDaiDien.SuatChieu.Phim?.TenPhim</div>
                <div class="mb-2"><strong>🕒 Suất chiếu:</strong> @gioChieu.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="mb-2"><strong>💺 Ghế đã đặt:</strong> @string.Join(", ", veList.Select(v => v.TenGhe))</div>
                <div class="mb-2"><strong>📅 Ngày đặt:</strong> @ngayDat</div>
                <div class="mb-2"><strong>💵 Tổng tiền:</strong> <span class="text-danger fw-bold">@ViewBag.TongTien.ToString("N0") VNĐ</span></div>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Index" asp-controller="Home" class="btn btn-success px-4 me-2">
            ⬅ Về Trang Chủ
        </a>
        <a asp-action="LichSuVe" asp-controller="NguoiDung" class="btn btn-outline-primary px-4">
            📄 Xem Lịch Sử Vé
        </a>
    </div>
</div>
