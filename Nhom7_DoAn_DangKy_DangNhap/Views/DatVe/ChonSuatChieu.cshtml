@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu>
@{
    var phim = ViewBag.Phim;
    var phong = ViewBag.Phong;
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4>
                🎬 @((phim != null) ? $"Phim: {phim.TenPhim}" : "")
                <br />
                🏢 @((phong != null) ? $"Phòng chiếu: {phong.TenPhong}" : "")
            </h4>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center">
                    Không có suất chiếu nào cho phòng này.
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>📅 Ngày chiếu</th>
                            <th>🕒 Giờ chiếu</th>
                            <th>💰 Giá vé</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sc in Model)
                        {
                            <tr>
                                <td>@sc.NgayChieu.ToString("dd/MM/yyyy")</td>
                                <td>@sc.ThoiGianChieu.ToString(@"hh\:mm")</td>
                                <td>@string.Format("{0:N0} VNĐ", sc.GiaVe)</td>
                                <td>
                                    <a asp-controller="DatVe"
                                       asp-action="ChonGhe"
                                       asp-route-maSuatChieu="@sc.MaSuatChieu"
                                       class="btn btn-warning btn-sm">
                                        Chọn ghế
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
