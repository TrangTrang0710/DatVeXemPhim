@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu>
@{
    var phim = ViewBag.Phim;
}
<h2>Chọn suất chiếu cho @phim.TenPhim</h2>
<table class="table table-dark table-bordered">
    <thead>
        <tr>
            <th>Ngày chiếu</th>
            <th>Giờ chiếu</th>
            <th>Phòng</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sc in Model)
        {
            <tr>
                <td>@sc.NgayChieu.ToString("dd/MM/yyyy")</td>
                <td>@sc.ThoiGianChieu.ToString(@"hh\:mm")</td>
                <td>@sc.PhongChieu?.TenPhong</td>
                <td>
                    <a href="/DatVe/ChonGhe?maSuatChieu=@sc.MaSuatChieu" class="btn btn-warning">Chọn ghế</a>
                </td>
            </tr>
        }
    </tbody>
</table>
