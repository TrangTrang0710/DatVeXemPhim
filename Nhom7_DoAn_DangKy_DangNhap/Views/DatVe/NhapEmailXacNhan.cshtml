@{
    ViewBag.Title = "Nhập Email để nhận OTP";

    var ghe = ViewBag.Ghe as string[] ?? new string[0];
    var maSuatChieu = ViewBag.MaSuatChieu as string ?? "";
    var error = ViewBag.Error as string;
}

<h2 class="text-center text-primary mb-3">📧 Nhập email để nhận mã OTP</h2>

<div class="card p-4 shadow-sm">

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <form method="post" action="/DatVe/XacNhanThanhToan">
        <input type="hidden" name="maSuatChieu" value="@maSuatChieu" />

        @foreach (var g in ghe)
        {
            <input type="hidden" name="gheDaChon" value="@g" />
        }

        <div class="mb-3">
            <label class="form-label">Email:</label>
            <input type="email" name="email" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-success w-100">Gửi OTP</button>
    </form>
</div>

