@{
    var suat = ViewBag.Suat as Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu;
    var ghe = ViewBag.GheDaChon as string[] ?? new string[0];
    var tongTien = ghe.Length * 45000;
    var email = ViewBag.Email as string ?? "";
    var error = ViewBag.Error as string;
}

<h2 class="text-center text-primary mb-3">Xác nhận thanh toán</h2>

<div class="card p-4 shadow-sm">

    <p><strong>Phim:</strong> @suat?.Phim?.TenPhim</p>
    <p><strong>Ngày chiếu:</strong> @suat?.NgayChieu.ToString("dd/MM/yyyy")</p>
    <p><strong>Giờ chiếu:</strong> @suat?.ThoiGianChieu</p>
    <p><strong>Ghế:</strong> @(ghe.Any() ? string.Join(", ", ghe) : "Chưa chọn ghế")</p>
    <p><strong>Tổng tiền:</strong> @tongTien.ToString("N0") VNĐ</p>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <form asp-action="XacNhanThanhToan" method="post">
        @foreach (var g in ghe)
        {
            <input type="hidden" name="gheDaChon" value="@g" />
        }

        <input type="hidden" name="maSuatChieu" value="@suat?.MaSuatChieu" />

        <div class="mb-3">
            <label class="form-label">Nhập email để nhận OTP:</label>
            <input type="email" name="email" value="@ViewBag.Email" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success w-100">Gửi OTP</button>
    </form>
</div>
