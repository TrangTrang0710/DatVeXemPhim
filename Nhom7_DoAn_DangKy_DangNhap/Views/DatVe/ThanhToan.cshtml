@{
    var suat = ViewBag.Suat;
    var ghe = (string[])ViewBag.Ghe;
    var tongTien = ghe.Length * 45000;
}

<h2 class="mb-4">🎟️ Xác nhận đặt vé</h2>

<ul class="list-group mb-4">
    <li class="list-group-item"><strong>🎬 Phim:</strong> @suat.Phim.TenPhim</li>
    <li class="list-group-item"><strong>🕒 Suất chiếu:</strong> @suat.NgayChieu.ToString("dd/MM/yyyy") - @suat.ThoiGianChieu</li>
    <li class="list-group-item"><strong>💺 Ghế đã chọn:</strong> @string.Join(", ", ghe)</li>
    <li class="list-group-item"><strong>💵 Tổng tiền:</strong> @tongTien.ToString("N0") VNĐ</li>
</ul>

<form asp-action="XacNhanThanhToan" method="post">
    @foreach (var g in ghe)
    {
        <input type="hidden" name="gheDaChon" value="@g" />
    }
    <input type="hidden" name="maSuatChieu" value="@suat.MaSuatChieu" />

    <div class="form-group mb-3">
        <label><strong>🔒 Phương thức thanh toán</strong></label>
        <select name="phuongThuc" class="form-control" id="phuongThuc" required>
            <option value="">-- Chọn phương thức --</option>
            <option value="MoMo">Ví MoMo</option>
            <option value="VNPay">VNPay</option>
            <option value="OTP">Xác nhận qua Email</option>
        </select>
    </div>

    <div class="form-group mb-3" id="emailSection" style="display: none;">
        <label for="email"><strong>📧 Nhập Email nhận mã OTP</strong></label>
        <input type="email" name="email" class="form-control" placeholder="example@email.com" />
    </div>

    <button type="submit" class="btn btn-success">✅ Xác nhận & Thanh toán</button>
</form>

<a asp-action="ChonSuatChieu" asp-controller="DatVe" class="btn btn-secondary mt-3">⬅ Quay lại chọn suất chiếu</a>

@section Scripts {
    <script>
        document.getElementById("phuongThuc").addEventListener("change", function () {
            const emailSection = document.getElementById("emailSection");
            if (this.value === "OTP") {
                emailSection.style.display = "block";
            } else {
                emailSection.style.display = "none";
            }
        });
    </script>
}
