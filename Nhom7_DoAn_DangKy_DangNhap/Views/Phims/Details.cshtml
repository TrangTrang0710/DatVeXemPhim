@model Nhom7_DoAn_DangKy_DangNhap.Models.Phim

@{
    ViewData["Title"] = "Thông tin chi tiết p phim";
    var daKhoiChieu = Model.NgayKhoiChieu.HasValue && Model.NgayKhoiChieu.Value <= DateTime.Today;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .trailer-container {
        width: 100%;
        margin-top: 30px;
        margin-bottom: 30px;
    }

        .trailer-container .ratio {
            width: 100%;
            max-width: 100%;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        }

        .trailer-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
</style>

<div class="container py-5">
    <h2 class="mb-4 text-success fw-bold">@Model.TenPhim</h2>
    <div class="row">
        <!-- Poster phim -->
        <div class="col-md-4">
            <img src="/images/@Model.Anh" alt="@Model.TenPhim" class="img-fluid rounded shadow" />
        </div>

        <!-- Thông tin phim -->
        <div class="col-md-8">
            <p class="fs-5">@Model.MoTa</p>

            <ul class="list-group list-group-flush fs-6">
                <li class="list-group-item"><strong>Thể loại:</strong> @Model.TheLoai</li>
                <li class="list-group-item"><strong>Thời lượng:</strong> @Model.ThoiLuong phút</li>
                <li class="list-group-item"><strong>Đạo diễn:</strong> @Model.DaoDien</li>
                <li class="list-group-item"><strong>Khởi chiếu:</strong> @(Model.NgayKhoiChieu?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</li>
                <li class="list-group-item"><strong>Người đăng:</strong> @Model.TaiKhoan?.TenDangNhap</li>
            </ul>

            <!-- Nút Đặt vé -->
            @if (daKhoiChieu)
            {
                <div class="mt-3">
                    <a href="/DatVe/ChonSuatChieu?maPhim=@Model.MaPhim" class="btn btn-warning">
                        🎟 Đặt vé ngay
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Trailer -->
    @if (!string.IsNullOrEmpty(Model.TrailerUrl))
    {
        <div class="mt-5">
            <h4 class="mb-3 text-primary fw-semibold">🎬 Trailer</h4>

            @{
                var embedUrl = Model.TrailerUrl;
                if (Model.TrailerUrl.Contains("watch?v="))
                {
                    var videoId = Model.TrailerUrl.Split("watch?v=").Last();
                    embedUrl = $"https://www.youtube.com/embed/{videoId}";
                }
            }

            <div class="trailer-container">
                <div class="ratio ratio-16x9">
                    <iframe src="@embedUrl" title="Trailer" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mt-5 text-muted text-center">
            <p>🎞 Chưa có trailer cho phim này.</p>
        </div>
    }

    <!-- Nút quay lại trang chủ -->
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            Quay lại trang chủ
        </a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
