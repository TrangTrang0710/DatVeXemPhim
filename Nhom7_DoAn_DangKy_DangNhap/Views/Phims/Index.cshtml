@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.Phim>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenPhim)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TheLoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThoiLuong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DaoDien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgayKhoiChieu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaiKhoan)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenPhim)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TheLoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ThoiLuong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MoTa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DaoDien)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NgayKhoiChieu)
            </td>
            <td>
                @item.TaiKhoan?.TenDangNhap)
            </td>
                <td>
                    <img src="@item.Anh" alt="Ảnh phim" width="100" />
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaPhim">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhim">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaPhim">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
