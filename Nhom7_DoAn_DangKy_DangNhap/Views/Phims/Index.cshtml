@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.Phim>
@{
    ViewData["Title"] = "Danh Sách Phim";
}

<h1 class="mb-4">🎬 Danh Sách Phim</h1>

<!-- Form tìm kiếm -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control"
               placeholder="🔍 Nhập tên phim hoặc thể loại"
               value="@ViewBag.SearchString" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a href="/Phims" class="btn btn-secondary">Xóa lọc</a>
    </div>
</form>

<!-- Bảng danh sách phim -->
<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark text-center">
        <tr>
            <th>Poster</th>
            <th>Tên Phim</th>
            <th>Thể Loại</th>
            <th>Thời Lượng</th>
            <th>Ngày Khởi Chiếu</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-danger">Không tìm thấy phim nào!</td>
            </tr>
        }
        else
        {
            @foreach (var phim in Model)
            {
                <tr>
                    <td class="text-center">
                        <img src="~/images/posters/@phim.Anh" alt="Poster" width="70" height="90" style="border-radius:4px" />
                    </td>
                    <td>@phim.TenPhim</td>
                    <td>@phim.TheLoai</td>
                    <td>@phim.ThoiLuong phút</td>
                    <td>@phim.NgayKhoiChieu?.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@phim.MaPhim" class="btn btn-info btn-sm">Xem</a>

                        @if (Context.Session.GetString("VaiTro") == "Admin" || Context.Session.GetString("VaiTro") == "NhanVien")
                        {
                            <a asp-action="Edit" asp-route-id="@phim.MaPhim" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@phim.MaPhim" class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc muốn xóa phim này?')">Xóa</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
