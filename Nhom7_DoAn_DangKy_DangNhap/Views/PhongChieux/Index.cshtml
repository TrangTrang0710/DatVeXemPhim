@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.PhongChieu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenPhong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiPhong)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenPhong)
            </td>
            <td>
                    @item.LoaiPhong?.MaLoaiPhong)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaPhongChieu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaPhongChieu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaPhongChieu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
