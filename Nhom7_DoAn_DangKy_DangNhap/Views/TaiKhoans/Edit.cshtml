@model Nhom7_DoAn_DangKy_DangNhap.Models.TaiKhoan

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4">
                    <h4 class="mb-0">Chỉnh sửa tài khoản</h4>
                </div>

                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Tên đăng nhập ẩn -->
                        <input type="hidden" asp-for="TenDangNhap" />

                        <!-- Mật khẩu: Hiển thị mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-bold">Mật khẩu</label>
                            <input asp-for="MatKhau" class="form-control" type="password" value="@Model.MatKhau" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <!-- Vai trò -->
                        <div class="mb-3">
                            <label asp-for="VaiTro" class="form-label fw-bold">Vai trò</label>
                            <select asp-for="VaiTro" class="form-select">
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Admin" selected="@(Model.VaiTro == "Admin")">Admin</option>
                                <option value="NhanVien" selected="@(Model.VaiTro == "NhanVien")">Nhân viên</option>
                                <option value="User" selected="@(Model.VaiTro == "User")">Khách hàng</option>
                            </select>
                            <span asp-validation-for="VaiTro" class="text-danger"></span>
                        </div>

                        <!-- Trạng thái tài khoản -->
                        <div class="mb-3">
                            <label asp-for="TrangThaiTK" class="form-label fw-bold">Trạng thái</label>
                            <select asp-for="TrangThaiTK" class="form-select">
                                <option value="Hoạt động" selected="@(Model.TrangThaiTK == "Hoạt động")">Hoạt động</option>
                                <option value="Đã khóa" selected="@(Model.TrangThaiTK == "Đã khóa")">Đã khóa</option>
                            </select>
                            <span asp-validation-for="TrangThaiTK" class="text-danger"></span>
                        </div>

                        <!-- Mã người dùng -->
                        <div class="mb-3">
                            <label asp-for="MaNguoiDung" class="form-label fw-bold">Người dùng liên kết</label>
                            <select asp-for="MaNguoiDung" class="form-select" asp-items="ViewBag.MaNguoiDung">
                                <option value="">-- Chọn người dùng --</option>
                            </select>
                            <span asp-validation-for="MaNguoiDung" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success">
                                💾 Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                ⬅ Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


