@model Nhom7_DoAn_DangKy_DangNhap.Models.TaiKhoan

@{
    ViewData["Title"] = "Xác nhận xóa tài khoản";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Xóa tài khoản</h4>
        </div>
        <div class="card-body">
            <p class="text-danger font-weight-bold">Bạn có chắc chắn muốn xóa tài khoản này không?</p>
            <dl class="row">
                <dt class="col-sm-3">Tên đăng nhập</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TenDangNhap)</dd>

                <dt class="col-sm-3">Mật khẩu</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MatKhau)</dd>

                <dt class="col-sm-3">Vai trò</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.VaiTro)</dd>

                <dt class="col-sm-3">Trạng thái tài khoản</dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThaiTK == "Đã khóa")
                    {
                        <span class="badge bg-danger">Đã khóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Đang hoạt động</span>
                    }
                </dd>
            </dl>
            <form asp-action="Delete">
                <input type="hidden" asp-for="TenDangNhap" />
                <button type="submit" class="btn btn-danger">Xóa</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</div>
