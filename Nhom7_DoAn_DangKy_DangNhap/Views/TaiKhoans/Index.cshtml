@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý Tài Khoản";
}

<h2 class="mb-4 text-primary">Quản lý Tài Khoản</h2>

<p>
    <a class="btn btn-success mb-3" asp-action="Create">➕ Thêm Tài Khoản</a>
</p>

<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.TenDangNhap)</th>
            <th>@Html.DisplayNameFor(model => model.MaNguoiDung)</th>
            <th>@Html.DisplayNameFor(model => model.MatKhau)</th>
            <th>@Html.DisplayNameFor(model => model.VaiTro)</th>
            <th>@Html.DisplayNameFor(model => model.TrangThaiTK)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenDangNhap</td>
                <td>@item.MaNguoiDung</td>
                <td>@item.MatKhau</td>
                <td>@item.VaiTro</td>
                <td>@item.TrangThaiTK</td>
                <td>
                    @{
                        var trangThai = item.TrangThaiTK?.Trim().ToLower();
                        string hienThi = "Không rõ";
                        string badge = "bg-warning";

                        if (trangThai == "1" || trangThai == "hoạt động" || trangThai == "true")
                        {
                            hienThi = "Đang hoạt động";
                            badge = "bg-success";
                        }
                        else if (trangThai == "0" || trangThai == "đã khóa" || trangThai == "false")
                        {
                            hienThi = "Đã khóa";
                            badge = "bg-secondary";
                        }
                    }
                    <span class="badge @badge">@hienThi</span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TenDangNhap">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.TenDangNhap">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.TenDangNhap">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
  }
    else
    {
<div class="alert alert-info">Hiện chưa có tài khoản nào.</div>
    }
<div class="text-end mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">🏠 Quay về Trang Chủ</a>
</div>

