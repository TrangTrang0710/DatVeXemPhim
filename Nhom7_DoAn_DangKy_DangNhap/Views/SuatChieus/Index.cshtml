@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ThoiGianChieu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaVe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phim)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhongChieu)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ThoiGianChieu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GiaVe)
            </td>
            <td>
                @item.Phim?.MaPhim)
            </td>
            <td>
                @item.PhongChieu?.MaPhongChieu)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaSuatChieu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaSuatChieu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaSuatChieu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
