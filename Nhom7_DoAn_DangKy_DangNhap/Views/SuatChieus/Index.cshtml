@model IEnumerable<Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu>
@{
    ViewData["Title"] = "Quản lý Suất Chiếu";
    Layout = "~/Views/Shared/Layout.cshtml";
}



<h2 class="mt-3">Quản lý Suất Chiếu</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm Suất Chiếu Mới</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().ThoiGianChieu)</th>
            <th>@Html.DisplayNameFor(model => model.First().GiaVe)</th>
            <th>Mã Phim</th>
            <th>Mã Phòng Chiếu</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ThoiGianChieu</td>
                <td>@item.GiaVe</td>
                <td>@item.Phim?.MaPhim</td>
                <td>@item.PhongChieu?.MaPhongChieu</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.MaSuatChieu">Sửa</a>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.MaSuatChieu">Chi tiết</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.MaSuatChieu">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="text-end mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">🏠 Quay về Trang Chủ</a>
</div>

