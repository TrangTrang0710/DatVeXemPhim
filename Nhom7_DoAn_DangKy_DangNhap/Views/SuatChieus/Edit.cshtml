@model Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu

@{
    ViewData["Title"] = "Chỉnh sửa suất chiếu";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Chỉnh sửa suất chiếu</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaSuatChieu" />

                <div class="mb-3">
                    <label asp-for="MaPhim" class="form-label fw-bold"></label>
                    <select asp-for="MaPhim" class="form-select" asp-items="ViewBag.MaPhim"></select>
                    <span asp-validation-for="MaPhim" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaPhongChieu" class="form-label fw-bold"></label>
                    <select asp-for="MaPhongChieu" class="form-select" asp-items="ViewBag.MaPhongChieu"></select>
                    <span asp-validation-for="MaPhongChieu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ThoiGianChieu" class="form-label fw-bold"></label>
                    <input asp-for="ThoiGianChieu" class="form-control" />
                    <span asp-validation-for="ThoiGianChieu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GiaVe" class="form-label fw-bold"></label>
                    <input asp-for="GiaVe" class="form-control" />
                    <span asp-validation-for="GiaVe" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <input type="submit" value="Lưu thay đổi" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
