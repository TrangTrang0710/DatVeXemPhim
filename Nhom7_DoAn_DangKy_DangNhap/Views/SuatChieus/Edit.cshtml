@model Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu
@{
    ViewData["Title"] = "Chỉnh Sửa Suất Chiếu";
}

<h2 class="mb-4 text-warning">✏️ Chỉnh Sửa Suất Chiếu</h2>

<form asp-action="Edit" method="post" class="p-4 border rounded shadow-sm bg-light">
    <input type="hidden" asp-for="MaSuatChieu" />

    <div class="mb-3">
        <label class="form-label">Chọn Phim</label>
        <select asp-for="MaPhim" class="form-select" asp-items="@(new SelectList(ViewBag.PhimList, "MaPhim", "TenPhim"))"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Chọn Phòng Chiếu</label>
        <select asp-for="MaPhongChieu" class="form-select" asp-items="@(new SelectList(ViewBag.PhongList, "MaPhongChieu", "TenPhong"))"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Ngày Chiếu</label>
        <input asp-for="NgayChieu" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Giờ Chiếu</label>
        <input asp-for="ThoiGianChieu" class="form-control" type="time" />
    </div>

    <div class="mb-3">
        <label class="form-label">Giá Vé (VNĐ)</label>
        <input asp-for="GiaVe" class="form-control" type="number" step="1000" />
    </div>

    <button type="submit" class="btn btn-primary">💾 Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">⬅️ Quay lại</a>
</form>
