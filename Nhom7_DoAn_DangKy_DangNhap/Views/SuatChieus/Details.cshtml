@model Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu
@{
    ViewData["Title"] = "Chi Tiết Suất Chiếu";
}

<h2 class="mb-4 text-info">🔍 Chi Tiết Suất Chiếu</h2>

<div class="card p-4 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">🎬 Tên Phim</dt>
        <dd class="col-sm-9">@Model.Phim?.TenPhim</dd>

        <dt class="col-sm-3">📅 Ngày Chiếu</dt>
        <dd class="col-sm-9">@Model.NgayChieu.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">⏰ Giờ Chiếu</dt>
        <dd class="col-sm-9">@Model.ThoiGianChieu.ToString(@"hh\:mm")</dd>

        <dt class="col-sm-3">🏢 Phòng Chiếu</dt>
        <dd class="col-sm-9">@Model.PhongChieu?.TenPhong</dd>

        <dt class="col-sm-3">💰 Giá Vé</dt>
        <dd class="col-sm-9">@Model.GiaVe.ToString("N0") VNĐ</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.MaSuatChieu" class="btn btn-warning">✏️ Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">⬅️ Quay lại</a>
</div>
