@model Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu

@{
    ViewData["Title"] = "Chi tiết suất chiếu";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Chi tiết suất chiếu</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-3">
                <dt class="col-sm-3 text-end fw-bold">
                    @Html.DisplayNameFor(model => model.ThoiGianChieu)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ThoiGianChieu)
                </dd>

                <dt class="col-sm-3 text-end fw-bold">
                    @Html.DisplayNameFor(model => model.GiaVe)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.GiaVe)
                </dd>

                <dt class="col-sm-3 text-end fw-bold">
                    @Html.DisplayNameFor(model => model.Phim)
                </dt>
                <dd class="col-sm-9">
                    @Model.Phim?.MaPhim
                </dd>

                <dt class="col-sm-3 text-end fw-bold">
                    @Html.DisplayNameFor(model => model.PhongChieu)
                </dt>
                <dd class="col-sm-9">
                    @Model.PhongChieu?.MaPhongChieu
                </dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Edit" asp-route-id="@Model?.MaSuatChieu" class="btn btn-sm btn-warning me-2">Chỉnh sửa</a>
            <a asp-action="Index" class="btn btn-sm btn-secondary">Quay lại danh sách</a>
        </div>
    </div>
</div>
