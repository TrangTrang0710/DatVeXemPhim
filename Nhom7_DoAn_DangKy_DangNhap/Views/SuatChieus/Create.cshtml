@model Nhom7_DoAn_DangKy_DangNhap.Models.SuatChieu

@{
    ViewData["Title"] = "Thêm suất chiếu mới";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white text-center">
            <h4>🎬 Thêm Suất Chiếu Mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaSuatChieu" class="form-label fw-bold">Mã Suất Chiếu</label>
                    <input asp-for="MaSuatChieu" class="form-control" />
                    <span asp-validation-for="MaSuatChieu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaPhim" class="form-label fw-bold">Phim</label>
                    <select asp-for="MaPhim" class="form-select" asp-items="ViewBag.MaPhim"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="MaPhongChieu" class="form-label fw-bold">Phòng Chiếu</label>
                    <select asp-for="MaPhongChieu" class="form-select" asp-items="ViewBag.MaPhongChieu"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="ThoiGianChieu" class="form-label fw-bold">Thời Gian Chiếu</label>
                    <input asp-for="ThoiGianChieu" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ThoiGianChieu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GiaVe" class="form-label fw-bold">Giá Vé</label>
                    <input asp-for="GiaVe" type="number" class="form-control" />
                    <span asp-validation-for="GiaVe" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success">➕ Thêm Suất Chiếu</button>
                </div>
            </form>
        </div>
        <div class="card-footer text-center">
            <a asp-action="Index" class="btn btn-outline-secondary mt-2">⬅ Quay lại danh sách</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
