@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var username = Context.Session.GetString("TenDangNhap");
    var vaitro = Context.Session.GetString("VaiTro");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rạp phim TX3</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <!-- 🔺 CAROUSEL ẢNH - TRẢI RỘNG & NỀN ĐEN -->
    <div style="background-color: black; padding: 20px 0;">
        <div id="carouselHelloSummer" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/Hinh1.jpg" class="d-block mx-auto w-100" style="max-height: 300px; object-fit: contain;" alt="Ảnh 1">
                </div>
                <div class="carousel-item">
                    <img src="~/images/Hinh2.jpg" class="d-block mx-auto w-100" style="max-height: 300px; object-fit: contain;" alt="Ảnh 2">
                </div>
                <div class="carousel-item">
                    <img src="~/images/Hinh3.jpg" class="d-block mx-auto w-100" style="max-height: 300px; object-fit: contain;" alt="Ảnh 3">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#carouselHelloSummer" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselHelloSummer" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
                <span class="visually-hidden">Next</span>
            </button>

            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselHelloSummer" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#carouselHelloSummer" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#carouselHelloSummer" data-bs-slide-to="2"></button>
            </div>
        </div>
    </div>


    <!-- 🔶 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-success" asp-controller="Home" asp-action="Index">🎬 RẠP PHIM TX3</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (!string.IsNullOrEmpty(vaitro))
                    {
                        if (vaitro == "KhachHang")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Phim" asp-action="TimKiem">🎬 Tìm kiếm phim</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DatVe" asp-action="Index">🎟 Đặt vé</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ThanhToan" asp-action="Index">💳 Thanh toán</a>
                            </li>
                        }
                        else if (vaitro == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuatChieus" asp-action="Index">🗓 Suất chiếu</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TaiKhoans" asp-action="Index">👤 Người dùng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Ves" asp-action="Index">🎟 Vé</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ThongKe" asp-action="Index">📊 Thống kê</a>
                            </li>
                        }
                    }
                </ul>

                <!-- Người dùng -->
                @if (!string.IsNullOrEmpty(username))
                {
                    <span class="me-3">👋 Xin chào <strong>@username</strong></span>
                    <a class="btn btn-outline-danger" asp-controller="Auth" asp-action="DangXuat">Đăng xuất</a>
                }
                else
                {
                    <a class="btn btn-success me-2 px-3" asp-controller="Auth" asp-action="DangNhap">Đăng nhập</a>
                    <a class="btn btn-success px-3" asp-controller="Auth" asp-action="DangKy">Đăng ký</a>
                }
            </div>
        </div>
    </nav>

    <!-- 🔽 Nội dung view -->
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

  

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- 🔻 Footer mở rộng -->
    <footer class="bg-dark text-white pt-5 pb-4">
        <div class="container text-md-left">
            <div class="row">

                <!-- Cột 1: Về Rạp -->
                <div class="col-md-4">
                    <h5 class="fw-bold">VỀ RẠP TX3</h5>
                    <div style="height: 5px; width: 80px; background-color: #7dd87d; border-radius: 3px;" class="mb-3"></div>
                    <p><a asp-controller="Home" asp-action="Rap" class="text-white text-decoration-none">Rạp</a></p>
                    <p><a asp-controller="Home" asp-action="LienHe" class="text-white text-decoration-none">Liên hệ</a></p>
                    <p><a href="#" class="text-white text-decoration-none">Địa chỉ:Tòa HA9,Đường Lĩnh Nam,Hoàng Mai, Hà Nội</a></p>
                  
                </div>

                <!-- Cột 2: Quy định -->
                <div class="col-md-4">
                    <h5 class="fw-bold">QUY ĐỊNH & ĐIỀU KHOẢN</h5>
                    <div style="height: 5px; width: 80px; background-color: #7dd87d; border-radius: 3px;" class="mb-3"></div>
                    <p><a asp-controller="Home" asp-action="QuyDinhThanhVien" class="text-white text-decoration-none">Quy định thành viên</a></p>
                    <p><a asp-controller="Home" asp-action="DieuKhoan" class="text-white text-decoration-none">Điều khoản</a></p>
                    <p><a asp-controller="Home" asp-action="HuongDanDatVe" class="text-white text-decoration-none">Hướng dẫn đặt vé trực tuyến</a></p>
                    <p><a asp-controller="Home" asp-action="QuyDinhChung" class="text-white text-decoration-none">Quy định và chính sách chung</a></p>
                    <p><a asp-controller="Home" asp-action="ChinhSachBaoMat" class="text-white text-decoration-none">Chính sách bảo vệ thông tin cá nhân</a></p>
                </div>

                <!-- Cột 3: CSKH -->
                <div class="col-md-4">
                    <h5 class="fw-bold">CHĂM SÓC KHÁCH HÀNG</h5>
                    <div style="height: 5px; width: 80px; background-color: #7dd87d; border-radius: 3px;" class="mb-3"></div>
                    <p><strong>Hotline:</strong> 19002099</p>
                    <p><strong>Giờ làm việc:</strong> 9:00 - 22:00 (Cả lễ, Tết)</p>
                    <p><strong>Email:</strong> anikachross@gmail.com</p>
                    <h6 class="mt-3">MẠNG XÃ HỘI</h6>
                    <a href="#"><img src="~/images/Facebook-icon.jpg" style="width: 30px;" class="me-2" /></a>
                    <a href="#"><img src="~/images/instagram-icon.jpg" style="width: 30px;" class="me-2" /></a>
                    <a href="#"><img src="~/images/tiktok-icon.jpg" style="width: 30px;" class="me-2" /></a>
                    <a href="#"><img src="~/images/youtube-icon.jpg" style="width: 30px;" /></a>
                </div>

            </div>
        </div>
    </footer>

</body>
</html>
