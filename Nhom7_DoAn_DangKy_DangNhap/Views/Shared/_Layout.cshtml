@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper<dynamic> HtmlHelper

@{
    string username = "";
    string vaitro = "";
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    if (Context.Session.IsAvailable)
    {
        username = Context.Session.GetString("TenDangNhap") ?? "";
        vaitro = Context.Session.GetString("VaiTro") ?? "";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rạp phim TX3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
        }

        #sidebar {
            width: 220px;
            background-color: #2c3e50;
            color: white;
            height: 100vh;
            position: fixed;
            top: 0;
            left: -220px;
            transition: left 0.3s ease;
            z-index: 1000;
            padding-top: 60px;
        }

            #sidebar.active {
                left: 0;
            }

            #sidebar a {
                color: white;
                display: block;
                padding: 12px 20px;
                text-decoration: none;
                transition: background 0.3s ease;
            }

                #sidebar a:hover {
                    background-color: #34495e;
                }

            #sidebar .title {
                position: absolute;
                top: 10px;
                left: 0;
                width: 100%;
                text-align: center;
                font-weight: bold;
                font-size: 18px;
            }

            #sidebar .user-info {
                text-align: center;
                font-size: 14px;
                color: #bdc3c7;
                margin-top: 20px;
            }

        #toggle-btn {
            position: fixed;
            top: 15px;
            left: 15px;
            z-index: 1100;
            font-size: 24px;
            background: #2c3e50;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
        }

        .main-content {
            margin-left: 0;
            padding: 20px;
            transition: margin-left 0.3s ease;
        }

            .main-content.shifted {
                margin-left: 220px;
            }

        footer {
            text-align: center;
            padding: 15px;
            background-color: #f5f5f5;
            margin-top: 30px;
        }

        #bannerCarousel img {
            width: 100%;
            height: 250px;
            object-fit: contain;
            border-radius: 10px;
            display: block;
        }

        .carousel-caption {
            background-color: rgba(0, 0, 0, 0.5);
            padding: 8px 12px;
            border-radius: 5px;
        }

        .carousel-control-prev,
        .carousel-control-next {
            filter: invert(1);
        }
    </style>
</head>
<body>
    <button id="toggle-btn">☰</button>

    <div id="sidebar">
        <div class="title">🎬 RẠP PHIM TX3</div>
        <a asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>

        @if (!string.IsNullOrEmpty(vaitro))
        {
            if (vaitro == "Admin")
            {
                <a asp-controller="SuatChieus" asp-action="Index">🗓 Quản lý Suất chiếu</a>
                <a asp-controller="TaiKhoan" asp-action="Index">👤 Quản lý Người dùng</a>
                <a asp-controller="Ve" asp-action="Index">🎟 Quản lý vé</a>
                <a asp-controller="ThongKe" asp-action="Index">📊 Thống kê</a>
            }
            else if (vaitro == "NhanVien")
            {
                <a asp-controller="Ve" asp-action="Index">🧾 Xử lý vé</a>
            }
            else if (vaitro == "KhachHang")
            {
                <a asp-controller="Phim" asp-action="Index">🔍 Tìm kiếm phim</a>
                <a asp-controller="DatVe" asp-action="Index">🪑 Đặt vé</a>
                <a asp-controller="ThanhToan" asp-action="Index">💳 Thanh toán</a>
            }
        }

        <hr class="text-light" />

        @if (!string.IsNullOrEmpty(username))
        {
            <div class="user-info">
                👋 Xin chào, <strong>@username</strong><br />
                <a asp-controller="Auth" asp-action="DangXuat" class="text-danger mt-2 d-block">🚪 Đăng xuất</a>
            </div>
        }
        else
        {
            <a asp-controller="Auth" asp-action="DangNhap">🔐 Đăng nhập</a>
            <a asp-controller="Auth" asp-action="DangKy">📝 Đăng ký</a>
        }
    </div>

    <div class="main-content" id="main">
        @if (!(controller == "Auth" && (action == "DangNhap" || action == "DangKy")))
        {
            <!-- 🔥 Banner quảng cáo -->
            <div id="bannerCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="@Url.Content("~/images/Hinh1.jpg")" alt="Banner 1" />
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Phim bom tấn tháng 8</h5>
                            <p>Giảm giá 50% vé suất đầu tiên!</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="@Url.Content("~/images/Hinh2.jpg")" alt="Banner 2" />
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Mua 2 tặng 1</h5>
                            <p>Khuyến mãi combo bắp + nước</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="@Url.Content("~/images/Hinh3.jpg")" alt="Banner 3" />
                        <div class="carousel-caption d-none d-md-block">
                            <h5>Top phim đang chiếu</h5>
                            <p>Click vào xem trailer và lịch chiếu</p>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        }

        <main role="main" class="pb-3">
            @if (TempData["ThongBao"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="border-top text-muted">
            &copy; 2025 - Nhóm 7 - Rạp phim trực tuyến -
            Địa chỉ:Tòa HA9 - 218 Lĩnh Nam - Hoàng Mai - Hà Nội
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#toggle-btn').click(function () {
                $('#sidebar').toggleClass('active');
                $('#main').toggleClass('shifted');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
