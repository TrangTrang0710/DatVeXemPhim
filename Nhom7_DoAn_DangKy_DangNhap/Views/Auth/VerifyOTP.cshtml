@{
    ViewData["Title"] = "Nhập mã OTP";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<h2 class="mb-4 text-center text-success">Nhập mã OTP</h2>

<div class="row justify-content-center">
    <div class="col-md-4 col-sm-6 col-10">
        <form asp-action="VerifyOTP" method="post" class="border rounded p-4 shadow-sm bg-light">
            <div class="mb-3">
                <label for="otp" class="form-label fw-semibold">Nhập mã OTP:</label>
                <input type="text" id="otp" name="otp" class="form-control text-center fs-5" maxlength="6" autocomplete="off" placeholder="6 chữ số" />
            </div>

            <button type="submit" class="btn btn-success w-100 mt-2">Xác nhận</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3" role="alert">
                @ViewBag.Error
            </div>
        }
    </div>
</div>
