@{
    ViewData["Title"] = "Đăng Nhập";
}

<h2 class="text-center text-primary mb-4">Đăng Nhập</h2>

<form asp-action="DangNhap" method="post" class="container" style="max-width: 400px;">
    <div class="mb-3">
        <label for="TenDangNhap" class="form-label">Tên đăng nhập</label>
        <input name="TenDangNhap" id="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập" required />
    </div>

    <div class="mb-3">
        <label for="MatKhau" class="form-label">Mật khẩu</label>
        <input name="MatKhau" id="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary w-100">Đăng Nhập</button>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ThongBao))
    {
        <p class="text-danger text-center mt-2">@ViewBag.ThongBao</p>
    }
</form>

<div class="text-center mt-3">
    <p>Chưa có tài khoản? <a asp-action="DangKy" class="text-decoration-none">Đăng ký tại đây</a></p>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại trang chủ</a>
</div>
