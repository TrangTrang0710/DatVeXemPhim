@model Nhom7_DoAn_DangKy_DangNhap.Models.Ghe

@{
    ViewData["Title"] = "Xóa ghế";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Ghe</h4>
    <hr />
    <p>
        Bạn có chắc muốn xóa ghế <strong>@Model.TenGhe</strong>
        ở phòng <strong>@Model.PhongChieu?.TenPhong (@Model.MaPhongChieu)</strong> không?
    </p>

    <dl class="row">
        <dt class="col-sm-3">Tên ghế</dt>
        <dd class="col-sm-9">@Model.TenGhe</dd>

        <dt class="col-sm-3">Phòng chiếu</dt>
        <dd class="col-sm-9">@Model.PhongChieu?.TenPhong (@Model.MaPhongChieu)</dd>

        <dt class="col-sm-3">Loại ghế</dt>
        <dd class="col-sm-9">@Model.LoaiGhe?.TenLoaiGhe (@Model.MaLoaiGhe)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="TenGhe" />
        <input type="hidden" asp-for="MaPhongChieu" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>
